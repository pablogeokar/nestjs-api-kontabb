# Database (PostgreSQL - same as web project)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth cookie signing secret (must match the web project)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars

# App
PORT=3001
APP_URL=http://localhost:3000

# Primeiro administrador (usado apenas por `pnpm db:seed:admin`)
# Não use uma senha reutilizada; mínimo de 6 caracteres.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrador

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cron Secret (same as web project)
CRON_SECRET=

# Módulo Fiscal — Certificados Digitais & SEFAZ
CERTIFICATE_ENCRYPTION_KEY=your-secret-key-at-least-32-characters-long
# Ambiente (PRODUCAO ou HOMOLOGACAO)
SEFAZ_AMBIENTE=HOMOLOGACAO

# Feature flag `sped.blocoG.leiauteHomologado` (F07 / Fase 0 → liberação Fase 2).
#
# Gate de liberação (tarefa 6.1): só defina "true" DEPOIS que AMBAS as
# pré-condições fiscais estiverem satisfeitas:
#   1. Fixtures normativas de G110/G125/0300 verdes (tarefa 5) — JÁ CONCLUÍDA.
#   2. Validação no PVA da Receita por UF/perfil (tarefa 6.2) — PENDENTE.
# A homologação é config-driven de propósito: um humano vira a chave para
# "true" após o aceite do PVA, sem alteração de código.
#
# Enquanto o PVA não assinar, MANTENHA "false": a geração de arquivos EFD que
# exijam Bloco G é bloqueada com diagnóstico específico
# (BLOCO_G_LEIAUTE_PENDENTE), nunca um arquivo inválido. Valores: true | false.
SPED_BLOCO_G_LEIAUTE_HOMOLOGADO=false

# Mailtrap.io Configuration
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER_EMAIL=
MAILTRAP_SENDER_NAME="Kontabb Notificações"

# Base pública dos arquivos em web/public/email (usa APP_URL quando vazia)
EMAIL_ASSETS_BASE_URL=http://localhost:3000
